{
    "name": "bear/tool-use",
    "description": "LLM Tool Use support for BEAR.Sunday applications",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "BEAR.Sunday",
        "AI",
        "Agent",
        "Tool Use",
        "LLM"
    ],
    "authors": [
        {
            "name": "Yoshitaka Jingu",
            "email": "yoshitaka.jingu@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "bear/resource": "^1.0",
        "koriym/app-state-diagram": "^0.17",
        "phpdocumentor/reflection-docblock": "^6.0",
        "ray/di": "^2.18"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "maglnet/composer-require-checker": "^4.18",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BEAR\\ToolUse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEAR\\ToolUse\\": "tests/"
        }
    },
    "scripts": {
        "setup": "composer bin tools install",
        "test": "phpunit",
        "cs": "vendor/bin/phpcs",
        "cs-fix": "vendor/bin/phpcbf",
        "sa": "vendor/bin/psalm --show-info=true",
        "phpmd": "vendor/bin/phpmd src text phpmd.xml",
        "tests": [
            "@cs",
            "@phpmd",
            "@sa",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "setup": "Install development tools",
        "test": "Run unit tests",
        "cs": "Check coding standards",
        "cs-fix": "Fix coding standards violations",
        "sa": "Run static analysis",
        "phpmd": "Run mess detector",
        "tests": "Run all checks (cs, sa, test)"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
