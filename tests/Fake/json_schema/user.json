{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "User ID (1-1000)",
            "minimum": 1,
            "maximum": 1000
        },
        "status": {
            "type": "string",
            "description": "User status",
            "enum": ["active", "inactive", "pending"]
        },
        "email": {
            "type": "string",
            "description": "User email address",
            "format": "email"
        },
        "age": {
            "type": "integer",
            "description": "User age (must be 18 or older)",
            "minimum": 18,
            "maximum": 120
        },
        "username": {
            "type": "string",
            "description": "Username (3-20 characters)",
            "minLength": 3,
            "maxLength": 20,
            "pattern": "^[a-zA-Z0-9_]+$"
        }
    },
    "required": ["id"]
}
